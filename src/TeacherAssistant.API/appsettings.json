{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "TenantSettings": {
    "RootDomain": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TeacherAssistantDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Issuer": "TeacherAssistantLms",
    "Audience": "TeacherAssistantClients",
    "ExpiryMinutes": 120
  },
  "RateLimiting": {
    "Enabled": true,
    "Login": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "JoinCode": {
      "PermitLimit": 10,
      "WindowMinutes": 10
    },
    "Public": {
      "PermitLimit": 20,
      "WindowMinutes": 10
    }
  },
  "Seed": {
    "AdminName": "Platform Admin",
    "AdminEmail": "admin@platform.local",
    "AdminPassword": "Admin@12345",
    "DemoTenantName": "Demo Academy",
    "DemoSubdomain": "demo",
    "DemoTeacherName": "Demo Teacher",
    "DemoTeacherEmail": "teacher@demo.local",
    "DemoTeacherPassword": "Demo@12345",
    "DemoPrimaryColor": "#0F766E",
    "DemoBio": "A demo teacher platform for testing."
  },
  "OpenAiSettings": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1"
  },
  "PaymentSettings": {
    "StripeSecretKey": "sk_test_placeholder",
    "StripeWebhookSecret": "whsec_placeholder",
    "FawryMerchantCode": "FAWRY_CODE_PLACEHOLDER",
    "FawrySecurityKey": "FAWRY_KEY_PLACEHOLDER",
    "PaymobApiKey": "PAYMOB_API_KEY_PLACEHOLDER",
    "PaymobHmacSecret": "PAYMOB_HMAC_PLACEHOLDER"
  }
}
