# ==========================================
# TeacherAssistant Frontend Environment Variables
# ==========================================

# Backend Web API base URL (including /api/v1)
# Development default: http://localhost:5014/api/v1
VITE_API_URL=http://localhost:5014/api/v1

# Multi-tenant routing mode: 'subdomain' | 'path'
# - 'subdomain': slug is read from hostname (e.g. demo.localhost:5173 -> slug "demo")
# - 'path': slug is read from URL prefix (e.g. localhost:5173/t/demo -> slug "demo")
VITE_TENANT_MODE=subdomain
